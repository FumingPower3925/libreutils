{
  "name": "@libreutils/tool-archive-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "View and extract archive files (ZIP, TAR, GZ) in the browser",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./meta": "./src/meta.ts"
  },
  "scripts": {
    "dev": "bun run ./src/dev.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target browser --minify --external 7z-wasm"
  },
  "dependencies": {
    "7z-wasm": "1.2.0",
    "@libreutils/shared": "file:../../shared",
    "@zip.js/zip.js": "2.8.23",
    "fflate": "^0.8.2",
    "libarchive.js": "^2.0.2"
  }
}
